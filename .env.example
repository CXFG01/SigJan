# Server-only database access. No browser authentication is used.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_AGENTS_MODEL=gpt-6-astra

# Random server secrets; do not prefix with NEXT_PUBLIC_.
# The token secret falls back to the Supabase server key if omitted.
CHECKER_TOKEN_SECRET=
CRON_SECRET=
CHECKER_DAILY_SESSIONS=30

# Optional import release label
DDINTER_VERSION=2.0
